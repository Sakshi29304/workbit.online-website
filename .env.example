# Copy this file to `.env` for LOCAL testing only.
# On Elastic Beanstalk, these are set via the console instead
# (Configuration -> Software -> Environment properties) — see GUIDE.md.

AWS_REGION=us-east-1

USERS_TABLE=TaskSphereUsers
TASKS_TABLE=TaskSphereTasks
NOTES_TABLE=TaskSphereNotes
ALERTS_TABLE=TaskSphereAlerts
ACTIVITY_TABLE=TaskSphereActivity
MESSAGES_TABLE=TaskSphereMessages
CONVERSATIONS_TABLE=TaskSphereConversations

SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:TaskSphereAlerts

JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of allowed origins for CORS, or * for any origin (testing only)
CORS_ORIGIN=*

PORT=8080

# ── Password reset (forgot-password emails) ──
# Must be a verified SES identity (an email address, or a domain, you've
# verified in the SES console). See GUIDE.md for setup steps.
SES_FROM_EMAIL=no-reply@yourdomain.com

# Your S3 site's URL — used to build the password-reset link in the email.
# No trailing slash.
FRONTEND_URL=http://your-bucket.s3-website-sa-east-1.amazonaws.com
